/* ===========================
   General Styles
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body{
    background:#f5f7fb;
    color:#333;
    line-height:1.6;
}

/* ===========================
   Header
=========================== */

header{
    background:linear-gradient(135deg,#0077ff,#00c6ff);
    color:#fff;
    text-align:center;
    padding:60px 20px;
}

header h1{
    font-size:42px;
    margin-bottom:15px;
}

header p{
    font-size:18px;
}

/* ===========================
   Navigation Bar
=========================== */

nav{
    background:#0a2342;
    position:sticky;
    top:0;
    z-index:1000;
}

nav ul{
    list-style:none;
    display:flex;
    justify-content:center;
    align-items:center;
}

nav ul li{
    margin:15px;
}

nav ul li a{
    color:#fff;
    text-decoration:none;
    font-weight:bold;
    transition:0.3s;
}

nav ul li a:hover{
    color:#00c6ff;
}

/* ===========================
   Main Container
=========================== */

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

/* ===========================
   Sections
=========================== */

section{
    background:#fff;
    margin:35px 0;
    padding:30px;
    border-radius:12px;
    box-shadow:0 4px 15px rgba(0,0,0,0.1);
}

section h2{
    color:#0077ff;
    margin-bottom:20px;
}

/* ===========================
   Cards
=========================== */

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-top:20px;
}

.card{
    background:#eef6ff;
    padding:20px;
    border-left:6px solid #0077ff;
    border-radius:10px;
    transition:0.3s;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 8px 18px rgba(0,0,0,0.15);
}

.card h3{
    color:#0077ff;
    margin-bottom:10px;
}

/* ===========================
   Video
=========================== */

.video{
    text-align:center;
}

.video video{
    width:90%;
    max-width:700px;
    border-radius:10px;
    box-shadow:0 5px 12px rgba(0,0,0,0.2);
}

.video p{
    margin-top:15px;
}

/* ===========================
   Table
=========================== */

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

table th{
    background:#0077ff;
    color:white;
}

table th,
table td{
    border:1px solid #ccc;
    padding:12px;
    text-align:left;
}

table tr:nth-child(even){
    background:#f2f2f2;
}

table tr:hover{
    background:#e8f4ff;
}

/* ===========================
   Questions
=========================== */

ol{
    padding-left:20px;
}

ol li{
    margin-bottom:15px;
    font-size:17px;
}

/* ===========================
   Answers
=========================== */

.answer{
    background:#e9fff0;
    border-left:6px solid green;
    padding:20px;
    margin:20px 0;
    border-radius:8px;
}

.answer h3{
    color:green;
    margin-bottom:10px;
}

.answer p{
    margin-top:10px;
}

/* ===========================
   Code Block
=========================== */

code{
    display:block;
    background:#272822;
    color:#ffffff;
    padding:15px;
    border-radius:8px;
    margin-top:10px;
    overflow-x:auto;
}

/* ===========================
   Footer
=========================== */

footer{
    background:#0a2342;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:40px;
}

footer h3{
    margin-bottom:10px;
}

/* ===========================
   Responsive Design
=========================== */

@media(max-width:768px){

    header h1{
        font-size:30px;
    }

    nav ul{
        flex-direction:column;
    }

    nav ul li{
        margin:10px 0;
    }

    .grid{
        grid-template-columns:1fr;
    }

    table{
        font-size:14px;
    }

    .video video{
        width:100%;
    }
}
